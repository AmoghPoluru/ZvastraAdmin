# Shared evega MongoDB. PAYLOAD_SECRET must match evega's or existing
# encrypted values (Instagram tokens) and sessions cannot be decrypted.
DATABASE_URL=
PAYLOAD_SECRET=

# This console's own origin (used for OAuth redirects and absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Public storefront origin — relative media/product URLs resolve against this.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Instagram / Meta. Redirect URI must be registered on the Meta app and point
# at THIS host: <NEXT_PUBLIC_APP_URL>/api/auth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3100/api/auth/instagram/callback

# AI banner generation + blob storage for generated images.
# The OpenAI API key is per-vendor (stored on the vendor doc), not an env var.
OPENAI_IMAGE_MODEL=gpt-image-1
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API (text notifications).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Baileys linked-device sessions. Must be a persistent, single-instance volume.
WHATSAPP_CHANNELS_SESSION_DIR=./sessions
WHATSAPP_CHANNELS_POST_THROTTLE_SECONDS=30

# Optional extra gate: only these emails may sign in (comma separated).
ADMIN_EMAIL_ALLOWLIST=
